# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/take_coffee_shop?schema=public"

# API
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
JWT_SECRET="replace-with-a-long-random-secret"
# Phiên phía server tồn tại tối đa 7 ngày; trình duyệt vẫn tự xóa token khi đóng.
AUTH_SESSION_TTL_HOURS=168
# Có thể khai báo nhiều địa chỉ frontend, phân cách bằng dấu phẩy.
CORS_ORIGINS="http://localhost:3000"

# Khoi phuc mat khau bang OTP email
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_SECRET="replace-with-a-different-long-random-secret"
# Khi phat trien co the dung console; production bat buoc cau hinh SMTP ben duoi.
MAIL_DELIVERY_MODE="console"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Kippora <no-reply@example.com>"

# Cua hang mac dinh
STORE_LATITUDE=10.8569371
STORE_LONGITUDE=106.7465042
STORE_ADDRESS="78 Duong So 29, Hiep Binh, Ho Chi Minh"

# Chu ky webhook doi soat ngan hang.
# Doi tac gui header: x-webhook-secret: <gia-tri-ben-duoi>
BANK_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
